[init]
	defaultBranch = main
[credential]
	# every host except GitHub (gh below): the Secret Service (gnome-keyring)
	helper = libsecret
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[includeIf "gitdir:~/work/"]
	path = ~/.config/git/work
