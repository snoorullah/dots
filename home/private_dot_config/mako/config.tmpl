# ~/.config/mako/config — Dracula · refined typography + layout
# ── Shape / layout ──
font=JetBrainsMono Nerd Font 11
width=440
height=180
margin=14
padding=16
border-size=2
border-radius=14
anchor=top-right
max-visible=5
layer=overlay

# ── Colours (Dracula) ──
background-color=#282a36
text-color=#f8f8f2
border-color=#bd93f9
progress-color=over #44475a

# ── Icons (app logos) ──
icons=1
max-icon-size=48
icon-location=left
icon-path={{ .chezmoi.homeDir }}/.nix-profile/share/icons/Papirus-Dark:{{ .chezmoi.homeDir }}/.nix-profile/share/icons/Papirus

# ── Typography hierarchy: app name (small, muted) · title (bold) · body ──
markup=1
format=<span size="small" foreground="#6272a4">%a</span>\n<b>%s</b>\n<span foreground="#c8c8d0">%b</span>
default-timeout=6000

# ── Grouping (stack per app, show count) ──
group-by=app-name

[grouped]
format=<span size="small" foreground="#6272a4">%a  ·  %g</span>\n<b>%s</b>\n<span foreground="#c8c8d0">%b</span>

# ── Per-urgency accents ──
[urgency=low]
border-color=#6272a4
text-color=#bdbdc7
default-timeout=4000

[urgency=normal]
border-color=#bd93f9

[urgency=high]
border-color=#ff5555
default-timeout=0

# ── Thunderbird (mail) — green accent + longer dwell so mail alerts stand
#    out and linger. Thunderbird emits notifications under app-name
#    "Thunderbird"; adjust here if `makoctl history` shows a different name.
[app-name="Thunderbird"]
border-color=#50fa7b
default-timeout=12000
