# hyprlock — lock screen on the Foundations palette (hexes rendered from .chezmoidata/palette.yaml).
# Bound to $mod+Escape in hyprland.lua. https://wiki.hypr.land/Hypr-Ecosystem/hyprlock/

general {
    hide_cursor = true
    grace = 0
    ignore_empty_input = true
}

# Blurred snapshot of whatever was on screen.
background {
    monitor =
    path = screenshot
    blur_passes = 3
    blur_size = 8
    noise = 0.012
    contrast = 0.9
    brightness = 0.7
    vibrancy = 0.18
    color = rgb({{ trimPrefix "#" .palette.ground }})
}

# Big clock. Font sizes here (96 and the date/labels below) are lock-screen-only, outside the token scale.
label {
    monitor =
    text = cmd[update:1000] echo "$(date '+%H:%M')"
    color = rgb({{ trimPrefix "#" .palette.accent }})
    font_size = 96
    font_family = Bricolage Grotesque
    position = 0, 170
    halign = center
    valign = center
}

# Date.
label {
    monitor =
    text = cmd[update:60000] echo "$(date '+%A, %d %B')"
    color = rgb({{ trimPrefix "#" .palette.text_dim }})
    font_size = 18
    font_family = JetBrains Mono
    position = 0, 95
    halign = center
    valign = center
}

# Why the user is away and for how long (Super+Esc picker; timetrack-away-label).
# Empty when nothing was declared, e.g. the 5-minute idle lock.
label {
    monitor =
    text = cmd[update:1000] ~/.local/bin/timetrack-away-label
    color = rgb({{ trimPrefix "#" .palette.waiting }})
    font_size = 22
    font_family = JetBrains Mono
    position = 0, 40
    halign = center
    valign = center
}

# Gentle prompt (on-brand).
label {
    monitor =
    text = what are you chasing?
    color = rgb({{ trimPrefix "#" .palette.text_dim }})
    font_size = 13
    font_family = JetBrains Mono
    position = 0, -10
    halign = center
    valign = center
}

# Password input — accent ring.
input-field {
    monitor =
    size = 300, 52
    outline_thickness = 2
    dots_size = 0.28
    dots_spacing = 0.3
    dots_center = true
    rounding = 14
    outer_color = rgb({{ trimPrefix "#" .palette.accent }})
    inner_color = rgb({{ trimPrefix "#" .palette.panel }})
    font_color = rgb({{ trimPrefix "#" .palette.text }})
    font_family = JetBrains Mono
    placeholder_text = <span foreground="##{{ trimPrefix "#" .palette.text_dim }}">password</span>
    check_color = rgb({{ trimPrefix "#" .palette.waiting }})
    fail_color = rgb({{ trimPrefix "#" .palette.failed }})
    fail_text = <span foreground="##{{ trimPrefix "#" .palette.failed }}">◆ failed: $FAIL ($ATTEMPTS)</span>
    fade_on_empty = false
    position = 0, -65
    halign = center
    valign = center
}
