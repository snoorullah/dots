# Copy to ~/.config/dots-mail/rules.toml (unmanaged: it names senders). Then, to apply it
# to mail already indexed:  dots-inbox retriage --dry-run --days 30   (counts, tags nothing)
#                           dots-inbox retriage --days 30
#
# Philosophy: the inbox is for mail somebody is WAITING on. Everything else is tagged and
# searchable (Archive / Alerts views in aerc) but never interrupts. Folder rules (Sent,
# Junk, Deleted, Drafts) and the alert/backup handlers run BEFORE anything below.
#
# Order of decision: folder -> [alerts]/[backup] -> own mail -> vip -> [[rule]] (first
# match wins) -> [people] domains -> local model (down = stays in the inbox).
#
# Tags (fixed vocabulary): people vip pr github alert backup security hr erp ticket
#   vendor fyi newsletter junk deleted sent critical.   inbox = tag `inbox`.

# addresses that are the user too (aliases); the account address is already known
me = ["me.alias@example.com"]

# a sender here is `vip`: inbox + a critical toast. An exact address or "@domain", matched
# against the parsed From address only. A display name never counts, and a bare word such as
# "client" matches nobody.
vip = ["boss@example.com", "@important-client.example"]

# mail from a person at these domains (not automated: no list-id, no bulk/auto-submitted
# header, no no-reply style address) is `people`, batched. Everything else asks the model.
[people]
domains = ["example.com"]

# Alert stream. `from` is a regex that must match the WHOLE parsed From address (not the
# display name; a From with several addresses matches nothing). `subject` is a regex with the
# named groups severity, name, state (FIRING|RESOLVED), scope. Omit `subject` for the
# default:  [CRITICAL] SomeAlert (FIRING) - cluster-1
[alerts]
from = "alerts@monitoring\\.example\\.com"
# authserv_id: the id YOUR receiving server writes first in Authentication-Results (look at
# the topmost Authentication-Results of a real mail). Only the `digest` path of [auth] uses it.
# authserv_id = "mx.example.net"
# enforce_auth = false   # false = shadow: a RESOLVED still only clears state for an authenticated
#                        # sender (and is logged); true = a first FIRING needs one too

# subject = '^\[(?P<severity>\w+)\]\s+(?P<name>\S+)\s+\((?P<state>FIRING|RESOLVED)\)\s*[-—]\s*(?P<scope>.+?)\s*$'
stale_hours = 6            # firing with no mail this long = stale (not notified)
min_firing_minutes = 30    # a resolution only notifies if it fired at least this long

# Sender authentication, in SHADOW (measured by `dots-inbox auth-report`, enforced nowhere).
# Behind a mail gateway the receiving server's own dmarc= fails for every genuine outsider, so
# the rule trusts only headers YOUR server stamped, by sender path. Every value is yours:
# nothing about a tenant, gateway or host is written in the repo.
#   internal  AuthAs Internal (exactly once), From domain in tenant_domains, cross-tenant id absent or yours
#   gateway   AuthAs Anonymous + Directionality Incoming, connecting IP (CIP) in gateway_ips, and an ARC
#             chain whose top seal is microsoft.com cv=pass, whose seal below it is gateway_sealer and
#             carries dmarc=pass header.from=<the From domain>. ARC signatures are NOT verified here:
#             the rule relies on the top seal's cv=pass.
#   digest    CIP in digest_ips and your server's own dmarc=pass for the From domain (uses authserv_id)
#   relay     CIP in relay_ips: a host that cannot authenticate; WEAK, never counts as authenticated
# [auth]
# tenant_domains = ["example.com"]
# tenant_ids     = ["00000000-0000-0000-0000-000000000000"]    # X-MS-Exchange-CrossTenant-Id of your tenant
# gateway_ips    = ["192.0.2.10", "192.0.2.11"]                # the gateway's outbound addresses
# gateway_sealer = "gateway.example.net"                       # d= of the gateway's ARC-Seal
# digest_ips     = []
# relay_ips      = ["192.0.2.20"]

# Optional names for the auth report: class = regex that must match the whole From address.
# [sender_class]
# teams-relay = "noreply@chat-relay\\.example"
# erp-relay = "support@erp\\.example\\.com"

# Backup job mail: success is archived silently, failure becomes an alert in the inbox.
[backup]
from = "root@.*\\.example\\.net"
ok = "backup successful"
fail = "backup (failed|error)|vzdump.*(failed|error)"

# GitHub: the `policy = "github"` rule below applies this. Reasons are the values of the
# X-GitHub-Reason header. Defaults shown. `author` = comments/reviews on YOUR pull
# requests (bots excepted: inbox, no toast). CI is notified only when it failed. A
# state_change (merged/closed) is inbox+batch only on your own PR. Everything else
# (push, subscribed, comment, digests, billing) is tagged github+fyi and leaves the inbox.
# [GitHub] account mail: token/SSH key/OAuth app added or regenerated = security, batched;
# expiry warnings = inbox, no toast.
[github]
notify_now = ["review_requested", "mention", "team_mention", "assign", "author", "ci_activity"]

# ----------------------------------------------------------------------------------------
# Rules. Every key you name must match; matching is a case-insensitive regex search, except
# `from`, which must match the WHOLE parsed address (write ".*@github\\.com", not "@github\\.com").
# A display name is never matched: anyone can write any name in front of their own address.
#
#   name     label shown in `retriage --dry-run`
#   from     the sender ADDRESS, full match           subject   Subject
#   folder   maildir folder ("INBOX")               body      first 4000 chars (use rarely)
#   header   table of header-name = regex (lower-case names: x-github-reason, list-id,
#            auto-submitted, precedence, x-github-sender, in-reply-to, references)
#   --- actions ---
#   add / remove   tags            inbox = true|false (default true)
#   notify   none (default) | batch (one summary toast per sync) | now (one toast each,
#            Open/Done buttons) | critical (like now, urgent)
#   critical a reason string: also tags `critical` and logs an event so an agent can
#            prepare a read-only analysis
#   policy   "github" -> the built-in GitHub policy decides
# ----------------------------------------------------------------------------------------

[[rule]]
name = "github"
from = ".*@github\\.com"
policy = "github"

[[rule]]
name = "account impersonation"
from = "support@erp\\.example\\.com"
subject = "account is being impersonated"
add = ["security", "erp"]
notify = "critical"
critical = "account impersonation warning"

[[rule]]
name = "ticket assigned to me"
from = "support@erp\\.example\\.com"
subject = "assigned a new task"
add = ["ticket", "erp"]
notify = "now"
critical = "ticket assigned to the user"

[[rule]]
name = "erp noise"
from = "(support@erp|no-reply@hr)\\.example\\.com"
subject = "New notification|Late Arrival|No Attendance|Anniversary|Weekly Pulse|Digest|Holidays|assignment on .* has been removed"
add = ["erp", "hr", "fyi"]
inbox = false

[[rule]]
name = "cloud identity digests"
from = "identity-noreply@cloud\\.example"
subject = "^PIM:|weekly (PIM )?digest|Protection Weekly"
add = ["security", "fyi"]
inbox = false

[[rule]]
name = "cloud identity"
from = "identity-noreply@cloud\\.example"
add = ["security"]
notify = "batch"

[[rule]]
name = "mail quarantine"
from = "postmaster@.*"
subject = "held messages"
add = ["security"]
notify = "batch"

# A chat relay puts the PERSON in the display name, which cannot be trusted, so this matches
# the relay's own address, plus a header only the receiving server stamps. It says "someone
# pinged you in chat", never who; no vip rule can name that person.
[[rule]]
name = "missed chat"
from = "noreply@chat-relay\\.example"
header = { x-ms-exchange-organization-authas = "^Internal$" }
add = ["people"]
notify = "batch"

[[rule]]
name = "host chatter"
from = "root@.*"
add = ["fyi"]
inbox = false

[[rule]]
name = "vendor action required"
from = "vendor@example\\.org"
subject = "action (required|needed)"
add = ["vendor"]
notify = "batch"

[[rule]]
name = "vendor"
from = "vendor@example\\.org|.*@mail\\.vendor\\.example"
add = ["vendor"]
inbox = false

[[rule]]
name = "mailing lists"
header = { list-id = "." }
add = ["newsletter"]
inbox = false
