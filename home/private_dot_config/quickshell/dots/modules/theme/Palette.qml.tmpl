pragma Singleton
// Rendered by chezmoi from .chezmoidata/palette.yaml. Only the raw palette lives here;
// Tokens.qml derives every other tone from it, so the fallback theme cannot drift from
// what `dots-theme preset` writes. Nothing here is read when tokens.json exists.
import Quickshell

Singleton {
  readonly property string ground: "{{ .palette.ground }}"
  readonly property string panel: "{{ .palette.panel }}"
  readonly property string raised: "{{ .palette.raised }}"
  readonly property string line: "{{ .palette.line }}"
  readonly property string border: "{{ .palette.border }}"
  readonly property string text: "{{ .palette.text }}"
  readonly property string text_dim: "{{ .palette.text_dim }}"
  readonly property string accent: "{{ .palette.accent }}"
  readonly property string accent_fg: "{{ .palette.accent_fg }}"
  readonly property string waiting: "{{ .palette.waiting }}"
  readonly property string failed: "{{ .palette.failed }}"
  readonly property string unknown: "{{ .palette.unknown }}"
}
