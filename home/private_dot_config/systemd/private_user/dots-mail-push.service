[Unit]
Description=dots-mail: IMAP IDLE on INBOX, so new mail syncs within seconds (goimapnotify)
Requires=dots-mail-auth.service
After=dots-mail-auth.service
ConditionPathIsMountPoint=%h/Mail
# default.target, NOT graphical-session.target: that target is not started in every login
# (it was inactive here), so nothing ever pulled this unit in and push mail never ran.

[Service]
Environment=PATH=%h/.nix-profile/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.nix-profile/bin/goimapnotify
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
