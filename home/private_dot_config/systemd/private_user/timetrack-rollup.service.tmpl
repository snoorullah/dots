[Unit]
Description=timetrack rollup (refresh local observe DB + Obsidian note)

[Service]
Type=oneshot
ExecStart={{ if eq .gpu "nixos" }}/etc/profiles/per-user/%u{{ else }}%h/.nix-profile{{ end }}/bin/timetrack rollup
ExecStartPost={{ if eq .gpu "nixos" }}/etc/profiles/per-user/%u{{ else }}%h/.nix-profile{{ end }}/bin/timetrack note
