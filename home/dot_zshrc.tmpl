# ~/.zshrc — antidote (Nix) + pinned zimfw modules (~/.zsh_plugins.txt, chezmoi).
export XDG_CONFIG_HOME="$HOME/.config"
export LANG=en_US.UTF-8

if [ -z "$SSH_AUTH_SOCK" ]; then
    eval $(ssh-agent)
fi

# --- PATH additions (tool installers; ~/.local/bin + nix-profile come from .zshenv) ---
export PNPM_HOME="{{ .chezmoi.homeDir }}/.local/share/pnpm"
export BUN_INSTALL="$HOME/.bun"
typeset -U path
path=($path $PNPM_HOME(N-/) $BUN_INSTALL/bin(N-/) $HOME/.grok/bin(N-/) {{ .chezmoi.homeDir }}/.lmstudio/bin(N-/))
fpath=(~/.grok/completions/zsh $fpath)

zstyle ':zim:git' aliases-prefix 'g'                                     # omz-style gs, gc, gp…
zstyle ':zim:completion' dumpfile "${XDG_CACHE_HOME:-$HOME/.cache}/zcompdump"
zstyle ':antidote:bundle' use-friendly-names 'yes'
source "$HOME/.nix-profile/share/antidote/antidote.zsh"
antidote load "$HOME/.zsh_plugins.txt" "${XDG_CACHE_HOME:-$HOME/.cache}/zsh_plugins.zsh"
unalias gh 2>/dev/null   # zimfw/git with the g prefix aliases gh to git help, hiding the GitHub CLI
bindkey -v; export KEYTIMEOUT=1
bindkey '^F' autosuggest-accept   # accept zsh-autosuggestions with Ctrl-F

source "$HOME/.config/zsh/aliases.zsh"
[[ -r ~/.secrets ]] && source ~/.secrets  # personal secrets (gitignored)
(( $+commands[kubectl] )) && { source <(kubectl completion zsh); compdef __start_kubectl k }
(( $+commands[fzf] ))     && source <(fzf --zsh)
autoload -U +X bashcompinit && bashcompinit
(( $+commands[terraform] )) && complete -o nospace -C "$(command -v terraform)" terraform
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
[ -r /etc/profile.d/nix.sh ] && source /etc/profile.d/nix.sh
eval "$(zoxide init zsh)"
eval "$(starship init zsh)"

# Recover the graphical session when this shell inherited none. herdr.service starts at
# LOGIN (default.target), before Hyprland exists, and every herdr pane inherits the server's
# environment -- so after a reboot each pane, and each Claude Code session started in one,
# had no WAYLAND_DISPLAY / DISPLAY / HYPRLAND_INSTANCE_SIGNATURE: wl-paste could not reach the
# compositor (Ctrl+V image paste in Claude failed) and hyprctl could not either. Hyprland
# pushes the live values into the systemd user manager at startup (hyprland.lua), so read
# them from there. Also runs when the inherited value is STALE (a Hyprland restart changes
# the socket and the signature), which is why the test is the socket, not the variable.
#
# A pane herdr restores at boot starts its shell BEFORE Hyprland, so checking once at startup
# is not enough: that shell then sits at its prompt for hours and everything run from it
# still has no session. So check again before every prompt and every command. Costs one
# stat, and systemctl runs only when a compositor is up and this shell does not have it.
_dots_graphical_env() {
  local run=${XDG_RUNTIME_DIR:-/run/user/$UID} kv
  [[ -S $run/${WAYLAND_DISPLAY:-wayland-0} ]] && return
  local -a socks=( $run/wayland-<->(N=) )
  (( $#socks )) && (( $+commands[systemctl] )) || return
  for kv in ${(f)"$(systemctl --user show-environment 2>/dev/null)"}; do
    case $kv in
      WAYLAND_DISPLAY=*|DISPLAY=*|HYPRLAND_INSTANCE_SIGNATURE=*|XDG_CURRENT_DESKTOP=*) export "$kv" ;;
    esac
  done
  # the X fallback below may have pointed this shell at the greeter's auth file
  [[ -S $run/${WAYLAND_DISPLAY:-wayland-0} ]] && unset XAUTHORITY
}
_dots_graphical_env
autoload -Uz add-zsh-hook
add-zsh-hook precmd _dots_graphical_env
add-zsh-hook preexec _dots_graphical_env

# X11 display + xauth (GDM puts xauth under $XDG_RUNTIME_DIR/gdm)
# Needed for xclip/clipboard-image paste in Claude Code, Electron apps, etc.
if [ -z "$WAYLAND_DISPLAY" ]; then
  for _xsock in /tmp/.X11-unix/X*; do
    # -O: only a display of ours. The login greeter's X1024 is gdm's and refuses us.
    [ -S "$_xsock" ] && [ -O "$_xsock" ] && export DISPLAY=":${_xsock##*/X}" && break
  done
  unset _xsock
  for _xauth in "/run/user/$(id -u)/gdm/Xauthority" "$HOME/.Xauthority"; do
    [ -f "$_xauth" ] && export XAUTHORITY="$_xauth" && break
  done
  unset _xauth
fi

# Re-assert the PATH contract last: nix.sh or tool hooks must not outrank these two.
typeset -U path PATH
path=($HOME/.local/bin(N-/) $HOME/.nix-profile/bin(N-/) $path)

