#!/usr/bin/env bash
# Root-level pieces. Runs once per machine. NixOS: handled by nix/hosts/nixos-laptop.
# Every distro-repo package goes through one of three lists below:
#   REQ   installed in one transaction; every name must exist in the family's default repos (tests/distro-matrix.sh
#         resolves them in a dry run inside each distro container)
#   FRESH installed only when the feature is absent (Docker): must also resolve on a fresh machine
#   OPT   installed one by one, and only when the distro has the package (no name can drop the rest)
# DOTS_PKG_LIST=1 prints the lists and exits before anything is touched (no sudo, no network).
set -euo pipefail
{{- $id := .chezmoi.osRelease.id }}
{{- $like := get .chezmoi.osRelease "idLike" | default "" }}
{{- if eq $id "nixos" }}
exit 0
{{- else }}
{{- $fam := "" }}
{{- if or (eq $id "arch") (contains "arch" $like) }}{{ $fam = "arch" }}
{{- else if or (eq $id "ubuntu") (eq $id "debian") (contains "debian" $like) }}{{ $fam = "debian" }}
{{- else if or (eq $id "fedora") (contains "fedora" $like) (contains "rhel" $like) }}{{ $fam = "fedora" }}
{{- end }}
{{- if eq $fam "" }}
echo "unsupported distro: {{ $id }}" >&2
exit 1
{{- else }}
me="${USER:-$(id -un)}"
KEYD_TAG=v2.6.0 KEYD_COMMIT=7c0aecb8bfd34dc8642bf4eefd2e59c89e61cec3   # github.com/rvaiya/keyd latest release (2026-10-07)
{{- if eq $fam "arch" }}

# ---- Arch family: package lists ----
REQ=(pipewire pipewire-pulse wireplumber polkit hyprlock xdg-desktop-portal-gtk tailscale wireshark-cli pacman-contrib fwupd{{ if eq .gpu "nvidia" }} nvidia-container-toolkit{{ end }})
FRESH=(docker)
OPT=(keyd greetd greetd-tuigreet)
KEYD_BUILD_DEPS=(base-devel git)
avail()       { pacman -Si "$1" >/dev/null 2>&1; }
pkg_install() { sudo pacman -S --needed --noconfirm "$@"; }
{{- else if eq $fam "debian" }}

# ---- Debian / Ubuntu family: package lists ----
REQ=(pipewire pipewire-pulse wireplumber xdg-desktop-portal-gtk curl gpg ca-certificates wireshark-common unattended-upgrades fwupd)
FRESH=(docker.io)
OPT=(keyd greetd tuigreet polkitd pkexec policykit-1 hyprlock{{ if eq $id "ubuntu" }} software-properties-common{{ end }})
KEYD_BUILD_DEPS=(build-essential git)
avail()       { [ -n "$(apt-cache madison "$1" 2>/dev/null)" ]; }
pkg_install() { sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "$@"; }
{{- else }}

# ---- Fedora / RHEL family: package lists ----
REQ=(pipewire wireplumber polkit xdg-desktop-portal-gtk wireshark-cli dnf-plugins-core fwupd)
FRESH=({{ if eq $id "fedora" }}moby-engine{{ end }})   # RHEL-likes: docker-ce from Docker's repo (added at install time)
OPT=(keyd greetd tuigreet hyprlock{{ if ne $id "fedora" }} epel-release{{ end }})
KEYD_BUILD_DEPS=(gcc make git)
avail()       { dnf info "$1" >/dev/null 2>&1; }
pkg_install() { sudo dnf install -y "$@"; }
{{- end }}

if [ "${DOTS_PKG_LIST:-0}" = 1 ]; then
  echo "required: ${REQ[*]} ${FRESH[*]}"
  echo "optional: ${OPT[*]}"
  exit 0
fi

# opt_install <pkg>...: install each package the distro has; report the ones it does not. Returns 1 if any is missing.
opt_install() {
  local p rc=0
  for p in "$@"; do
    if avail "$p"; then pkg_install "$p"; else echo "skip: package $p is not in this distro's repos" >&2; rc=1; fi
  done
  return $rc
}

command -v nix >/dev/null || { curl -fsSL https://install.determinate.systems/nix | sh -s -- install --no-confirm; }
DOCKER_PRESENT=0; { command -v dockerd || command -v docker; } >/dev/null 2>&1 && DOCKER_PRESENT=1
{{- if eq $fam "arch" }}

# ---- Arch family ----
pkg_install "${REQ[@]}"
{{-   if eq .gpu "nvidia" }}
# the driver only when none is installed yet (never swap an existing nvidia/nvidia-dkms/-open setup)
pacman -Qq nvidia-utils >/dev/null 2>&1 || pkg_install nvidia-open-dkms nvidia-utils
{{-   end }}
[ -e /etc/pam.d/hyprlock ] || printf 'auth include system-login\n' | sudo tee /etc/pam.d/hyprlock >/dev/null
if [ "$DOCKER_PRESENT" = 0 ]; then pkg_install "${FRESH[@]}"; else echo "docker: already installed, not touching it" >&2; fi
opt_install greetd greetd-tuigreet || true   # greetd is configured below only if tuigreet ended up installed
{{- else if eq $fam "debian" }}

# ---- Debian / Ubuntu family ----
sudo apt-get update
# wireshark capture permission (dumpcap setuid for the wireshark group): preseed before wireshark-common (in REQ)
echo 'wireshark-common wireshark-common/install-setuid boolean true' | sudo debconf-set-selections
pkg_install "${REQ[@]}"
sudo DEBIAN_FRONTEND=noninteractive dpkg-reconfigure -f noninteractive wireshark-common   # applies it if already installed
if avail polkitd; then opt_install polkitd pkexec || true; else opt_install policykit-1 || true; fi
# greetd's postinst enables greetd.service itself, so greetd is installed ONLY together with tuigreet
# (tuigreet has no apt package on noble/bookworm; then greetd is not installed at all).
if avail tuigreet && avail greetd; then pkg_install greetd tuigreet; else echo "greetd: tuigreet not packaged here; greetd not installed" >&2; fi
if ! command -v hyprlock >/dev/null; then
  if avail hyprlock; then pkg_install hyprlock
{{-   if eq $id "ubuntu" }}
  elif opt_install software-properties-common && sudo add-apt-repository -y ppa:cppiber/hyprland && sudo apt-get update && avail hyprlock; then
    pkg_install hyprlock
{{-   end }}
  else echo "hyprlock: not available for {{ $id }}; install it yourself (Nix cannot provide its PAM integration)" >&2
  fi
fi
{{-   if eq .gpu "nvidia" }}
if ! command -v nvidia-smi >/dev/null; then
  if command -v ubuntu-drivers >/dev/null; then sudo ubuntu-drivers install || echo "nvidia: ubuntu-drivers install failed; install the driver yourself" >&2
  else echo "nvidia: no driver found and no ubuntu-drivers; install the NVIDIA driver yourself" >&2; fi
fi
{{-   end }}
[ -e /etc/pam.d/hyprlock ] || printf '@include common-auth\n' | sudo tee /etc/pam.d/hyprlock >/dev/null
# Docker Engine: docker.io only on a machine without Docker (docker-ce and docker.io conflict)
if [ "$DOCKER_PRESENT" = 0 ]; then pkg_install "${FRESH[@]}"; else echo "docker: already installed, not touching it" >&2; fi
{{-   if eq .gpu "nvidia" }}
# nvidia-container-toolkit from NVIDIA's apt repo
curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | sudo gpg --dearmor --yes -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg
curl -fsSL https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list \
  | sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' \
  | sudo tee /etc/apt/sources.list.d/nvidia-container-toolkit.list >/dev/null
sudo apt-get update
pkg_install nvidia-container-toolkit
{{-   end }}
# tailscale daemon: no distro package, use the official installer (no `tailscale up`: auth is yours)
command -v tailscaled >/dev/null || curl -fsSL https://tailscale.com/install.sh | sh
{{- else }}

# ---- Fedora / RHEL family ----
{{-   if ne $id "fedora" }}
# RHEL-likes: EPEL carries hyprlock/greetd/tuigreet when they exist at all
rpm -q epel-release >/dev/null 2>&1 || opt_install epel-release || true
{{-   end }}
pkg_install "${REQ[@]}"
opt_install greetd tuigreet || true   # greetd is configured below only if tuigreet ended up installed
if ! command -v hyprlock >/dev/null; then
  if avail hyprlock; then pkg_install hyprlock
{{-   if eq $id "fedora" }}
  elif sudo dnf copr enable -y solopasha/hyprland && avail hyprlock; then pkg_install hyprlock
{{-   end }}
  else echo "hyprlock: not available for {{ $id }}{{ if ne $id "fedora" }} (not in EPEL){{ end }}; skipped" >&2
  fi
fi
[ -e /etc/pam.d/hyprlock ] || printf 'auth include system-auth\n' | sudo tee /etc/pam.d/hyprlock >/dev/null
# Docker Engine, only on a machine without Docker: Fedora ships moby-engine, RHEL-likes need docker-ce
if [ "$DOCKER_PRESENT" = 1 ]; then echo "docker: already installed, not touching it" >&2
elif avail moby-engine; then pkg_install moby-engine
else
  pkg_install dnf-plugins-core
  sudo dnf config-manager --add-repo https://download.docker.com/linux/centos/docker-ce.repo
  pkg_install docker-ce
fi
{{-   if eq .gpu "nvidia" }}
# nvidia-container-toolkit from NVIDIA's rpm repo
curl -fsSL https://nvidia.github.io/libnvidia-container/stable/rpm/nvidia-container-toolkit.repo | sudo tee /etc/yum.repos.d/nvidia-container-toolkit.repo >/dev/null
pkg_install nvidia-container-toolkit
{{-   end }}
# tailscale daemon: official installer sets up the dnf repo (no `tailscale up`: auth is yours)
command -v tailscaled >/dev/null || curl -fsSL https://tailscale.com/install.sh | sh
{{- end }}

# ---- all families ----
sudo install -Dm644 /dev/stdin /usr/share/wayland-sessions/hyprland-dots.desktop <<DESKTOP
[Desktop Entry]
Name=Hyprland (dots)
Exec={{ .chezmoi.homeDir }}/.local/bin/start-hyprland-dots
Type=Application
DESKTOP

# greetd: only when tuigreet is installed. Configure for the session above, and enable it ONLY when no display
# manager exists. An existing display manager is never disabled or replaced.
if command -v tuigreet >/dev/null && systemctl cat greetd.service >/dev/null 2>&1; then
  greeter=""
  for u in greeter _greetd greetd; do id -u "$u" >/dev/null 2>&1 && { greeter="$u"; break; }; done
  if [ -z "$greeter" ]; then sudo useradd -r -M -s /usr/sbin/nologin -G video greeter 2>/dev/null || true; greeter=greeter; fi
  if [ ! -s /etc/greetd/config.toml ] || grep -qE 'agreety|start-hyprland-dots' /etc/greetd/config.toml; then
    sudo install -d /etc/greetd
    sudo tee /etc/greetd/config.toml >/dev/null <<GREETD
[terminal]
vt = 1

[default_session]
command = "tuigreet --time --remember --cmd {{ .chezmoi.homeDir }}/.local/bin/start-hyprland-dots"
user = "$greeter"
GREETD
  else
    echo "greetd: existing custom /etc/greetd/config.toml left untouched" >&2
  fi
  if ! systemctl cat display-manager.service >/dev/null 2>&1; then
    sudo systemctl enable greetd.service
  else
    echo "greetd: a display manager already exists; not enabling greetd" >&2
  fi
else
  echo "greetd: tuigreet not installed; greetd not configured (log in from your display manager)" >&2
fi

# keyd (R27): the distro package when it has one, else the pinned upstream release built from source.
# A failed build skips keyd with a message; it never aborts this script.
build_keyd() {
  local src
  opt_install "${KEYD_BUILD_DEPS[@]}" || return 1
  src="$(mktemp -d)"
  git clone --quiet --depth 1 --branch "$KEYD_TAG" https://github.com/rvaiya/keyd "$src/keyd" || return 1
  [ "$(git -C "$src/keyd" rev-parse HEAD)" = "$KEYD_COMMIT" ] || { echo "keyd: $KEYD_TAG is not $KEYD_COMMIT" >&2; return 1; }
  make -C "$src/keyd" || return 1
  sudo make -C "$src/keyd" install || return 1
  sudo systemctl daemon-reload
  rm -rf "$src"
}
if ! command -v keyd >/dev/null; then
  if avail keyd; then pkg_install keyd
  else echo "keyd: not packaged for {{ $id }}; building $KEYD_TAG from source" >&2; build_keyd || echo "keyd: build failed; keyd skipped" >&2
  fi
fi
if command -v keyd >/dev/null; then
  sudo install -Dm644 {{ joinPath .chezmoi.workingTree "system/keyd/default.conf" | quote }} /etc/keyd/default.conf
  sudo systemctl enable --now keyd
else
  echo "keyd: not installed; /etc/keyd/default.conf not written" >&2
fi

# Docker: enable (a no-op restart-wise when it already runs). Restart only if nvidia-ctk changed daemon.json.
if command -v dockerd >/dev/null || command -v docker >/dev/null; then
  sudo systemctl enable --now docker.service
  sudo usermod -aG docker "$me"
{{- if eq .gpu "nvidia" }}
  if command -v nvidia-ctk >/dev/null; then
    before="$(sudo cat /etc/docker/daemon.json 2>/dev/null || :)"
    sudo nvidia-ctk runtime configure --runtime=docker
    after="$(sudo cat /etc/docker/daemon.json 2>/dev/null || :)"
    if [ "$before" != "$after" ]; then sudo systemctl restart docker.service; else echo "docker: nvidia runtime already configured; no restart" >&2; fi
  fi
{{- end }}
fi
sudo systemctl enable --now tailscaled.service
getent group wireshark >/dev/null || sudo groupadd -r wireshark
sudo usermod -aG wireshark "$me"
echo "log out and back in for the docker and wireshark groups to apply"
{{- end }}
{{- end }}
