#!/usr/bin/env bash
# nix inputs hash: {{ include (joinPath .chezmoi.workingTree "nix/flake.lock") | sha256sum }}
# nix module hash: {{ include (joinPath .chezmoi.workingTree "nix/home.nix") | sha256sum }} {{ include (joinPath .chezmoi.workingTree "nix/pkgs/overlay.nix") | sha256sum }} {{ include (joinPath .chezmoi.workingTree "nix/flake.nix") | sha256sum }} {{ include (joinPath .chezmoi.workingTree "nix/pkgs/tmux-plugins.json") | sha256sum }}
set -euo pipefail
{{- if ne .gpu "nixos" }}
export USER="${USER:-$(id -un)}" HOME="${HOME:-$(getent passwd "$USER" | cut -d: -f6)}"
[ -e /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ] && . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
export NIX_CONFIG="experimental-features = nix-command flakes"
nix run home-manager/master -- switch --impure --flake {{ joinPath .chezmoi.workingTree "nix" | quote }}#{{ .gpu }} -b pre-dots
{{- else }}
# NixOS: packages come from nixos-rebuild (see docs/install.md); nothing to do here.
exit 0
{{- end }}
