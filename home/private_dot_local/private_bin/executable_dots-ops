#!/usr/bin/env bash
# dots-ops CLI. Later tasks add: status, waybar (T5), relay (T4), perf-mode (T10), pins-bump (T11).
set -uo pipefail
if [ "$(id -u)" = 0 ]; then LIB=/usr/local/lib/dots-ops/lib.sh
else LIB="${OPS_LIB:-$HOME/.local/lib/dots-ops/lib.sh}"; [ -f "$LIB" ] || LIB=/usr/local/lib/dots-ops/lib.sh; fi
source "$LIB"
: "${OPS_JOBS_DIR:=$HOME/.local/lib/dots-ops/jobs}"
here=$(dirname "$(readlink -f "$0")")
usage() { echo "usage: dots-ops run <job> [--now] | answer <job> <approve|skip|snooze> | idle-start | idle-end" >&2; exit 2; }

sudo_runner() {   # R8: sudo -n only; a refusal is logged, never fatal
  local sc; read -ra sc <<< "$OPS_SUDO"
  "${sc[@]}" "$OPS_RUNNER" "$@" || ops_log system warn "sudo runner refused: $*"
  return 0
}
job_bin() { local b="$here/dots-ops-job"; [ -e "$b" ] || b="$here/executable_dots-ops-job"; echo "$b"; }
valid_job() { [[ ${1:-} =~ ^[a-z0-9-]+$ ]] || { echo "bad job name" >&2; exit 2; }; }

case "${1:-}" in
  run)
    job=${2:-}; valid_job "$job"; now=0; [ "${3:-}" = --now ] && now=1
    if [ -f "$OPS_JOBS_DIR/$job.sh" ]; then   # user job
      if [ "$now" = 1 ]; then OPS_FORCE=1 exec bash "$(job_bin)" "$job"
      else exec systemctl --user start --no-block "dots-ops@$job.service"; fi
    else                                       # root job (R4)
      if [ "$now" = 1 ]; then sudo_runner "$job" run-now; else sudo_runner "$job" run; fi
    fi ;;
  answer)
    [ $# -eq 3 ] || usage
    case $3 in approve|skip|snooze) ;; *) usage ;; esac
    valid_job "$2"; ops_answer "$2" "$3" ;;
  idle-start)
    mkdir -p "$(dirname "$OPS_IDLE_FLAG")"; touch "$OPS_IDLE_FLAG"
    systemctl --user start --no-block dots-ops-idle.target || ops_log system warn "idle target failed to start"
    sudo_runner system idle-run ;;
  idle-end)
    rm -f "$OPS_IDLE_FLAG"
    sudo_runner system idle-end ;;   # R3
  *) usage ;;
esac
