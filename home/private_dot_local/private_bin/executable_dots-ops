#!/usr/bin/env bash
# dots-ops CLI. Later tasks add: status, waybar (T5), perf-mode (T10), pins-bump (T11).
set -uo pipefail
if [ "$EUID" = 0 ]; then LIB=/usr/local/lib/dots-ops/lib.sh
else LIB="${OPS_LIB:-$HOME/.local/lib/dots-ops/lib.sh}"; [ -f "$LIB" ] || LIB=/usr/local/lib/dots-ops/lib.sh; fi
source "$LIB"
: "${OPS_JOBS_DIR:=$HOME/.local/lib/dots-ops/jobs}"
here=$(dirname "$(readlink -f "$0")")
usage() { echo "usage: dots-ops run <job> [--now] | answer <job> <approve|alt|skip|snooze> | idle-start [--fallback] | idle-end | relay | waybar | status" >&2; exit 2; }

sudo_runner() {   # R8: sudo -n only; returns the runner rc (callers decide if it is fatal)
  local sc; read -ra sc <<< "$OPS_SUDO"
  "${sc[@]}" "$OPS_RUNNER" "$@" || { local rc=$?; ops_log system warn "sudo runner failed (rc=$rc): $*"; return "$rc"; }
}
relay() {   # root → user: /var/lib/dots-ops/<job>.json → ops_state; ask-<job>.json → ops_ask (user context only)
  [ "$OPS_IS_ROOT" != 1 ] || { echo "dots-ops relay runs as the desktop user, not root" >&2; exit 2; }
  local f base st sum changed seen ask_sum q act alt altl asked p job
  mkdir -p "$OPS_STATE/relayed"
  for f in "$OPS_ROOT_STATE"/*.json; do
    [ -f "$f" ] || continue
    base=$(basename "$f" .json)
    if [[ $base =~ ^ask-([a-z0-9][a-z0-9-]*)$ ]]; then   # pending root approval
      job=${BASH_REMATCH[1]}
      ask_sum=$(sha256sum < "$f" | cut -d' ' -f1)
      [ "$(cat "$OPS_STATE/relayed/ask-$job" 2>/dev/null)" = "$ask_sum" ] && continue   # already asked
      q=$(jq -er '.question | strings' "$f" 2>/dev/null) && act=$(jq -er '.action | strings' "$f" 2>/dev/null) \
        || { ops_log "$job" warn "relay: unreadable ask file"; continue; }
      alt=$(jq -r '.alt_action // "" | strings' "$f" 2>/dev/null)
      altl=$(jq -r '.alt_label // "" | strings' "$f" 2>/dev/null)
      asked=$(jq -r '.asked // 0' "$f" 2>/dev/null); [[ $asked =~ ^[0-9]+$ ]] || asked=0
      if [ $(( $(ops_now) - asked )) -ge 86400 ]; then   # R21: a stale ask (root job stopped asking) is dropped
        ops_log "$job" info "relay: dropped stale root ask (asked $asked)"
        echo "$ask_sum" > "$OPS_STATE/relayed/ask-$job"; continue
      fi
      if [[ $act != root:* ]] || { [ -n "$alt" ] && [[ $alt != root:* ]]; }; then   # root may only ask for root actions
        ops_log "$job" warn "relay: ignored non-root action in ask file"; continue
      fi
      # R48: a live pending showing another question/action than the newest root ask is replaced, never kept —
      # otherwise ops_ask returns early and the owner would approve text they never saw for the root's new ask
      p="$OPS_STATE/pending/$job.json"
      if [ -f "$p" ] && [ "$(jq -r '.action // "" | strings' "$p" 2>/dev/null)" = "${act}" ] \
           && [ "$(jq -r '.question // "" | strings' "$p" 2>/dev/null)" = "$q" ] \
           && [ "$(jq -r '.alt_action // "" | strings' "$p" 2>/dev/null)" = "$alt" ]; then :
      elif [ -f "$p" ] && [[ $(jq -r '.action // "" | strings' "$p" 2>/dev/null) == root:* ]]; then
        rm -f "$p"; ops_log "$job" info "relay: pending replaced by a changed root ask"
      fi
      if [ -n "$alt" ]; then ops_ask "$job" "$q" "$act" "$alt" "$altl"; else ops_ask "$job" "$q" "$act"; fi
      echo "$ask_sum" > "$OPS_STATE/relayed/ask-$job"
      continue
    fi
    [[ $base =~ ^[a-z0-9][a-z0-9-]*$ ]] || continue
    st=$(jq -r '.status // ""' "$f" 2>/dev/null); sum=$(jq -r '.summary // ""' "$f" 2>/dev/null)
    changed=$(jq -r '.changed // 0' "$f" 2>/dev/null)
    case $st in ok|warn|fail) ;; *) continue ;; esac
    [[ $changed =~ ^[0-9]+$ ]] || continue
    seen=$(cat "$OPS_STATE/relayed/$base" 2>/dev/null || echo 0)
    [[ $seen =~ ^[0-9]+$ ]] || seen=0
    [ "$changed" -gt "$seen" ] || continue
    if [ -f "$OPS_JOBS_DIR/$base.sh" ]; then   # R22: a user job owns this name; never overwrite its status
      ops_log "$base" warn "relay: root status skipped (name collides with user job)"
      echo "$changed" > "$OPS_STATE/relayed/$base"; continue
    fi
    ops_state "$base" "$st" "$sum"
    echo "$changed" > "$OPS_STATE/relayed/$base"
  done
  # R48: a root ask that disappeared (withdrawn, applied, refused) withdraws the user's pending for it
  if [ -d "$OPS_ROOT_STATE" ]; then
    local gone=0
    for f in "$OPS_STATE"/relayed/ask-*; do
      [ -f "$f" ] || continue
      job=${f##*/relayed/ask-}
      [[ $job =~ ^[a-z0-9][a-z0-9-]*$ ]] || continue
      [ -e "$OPS_ROOT_STATE/ask-$job.json" ] && continue
      p="$OPS_STATE/pending/$job.json"
      if [ -f "$p" ] && [[ $(jq -r '.action // "" | strings' "$p" 2>/dev/null) == root:* ]]; then
        rm -f "$p"; ops_log "$job" info "relay: root ask withdrawn; pending removed"; gone=1
      fi
      rm -f "$f"
    done
    [ "$gone" = 0 ] || ops_signal   # the Waybar ask count drops
  fi
  return 0
}
job_bin() { local b="$here/dots-ops-job"; [ -e "$b" ] || b="$here/executable_dots-ops-job"; echo "$b"; }
valid_job() { [[ ${1:-} =~ ^[a-z0-9-]+$ ]] || { echo "bad job name" >&2; exit 2; }; }

case "${1:-}" in
  run)
    job=${2:-}; valid_job "$job"; now=0; [ "${3:-}" = --now ] && now=1
    if [ -f "$OPS_JOBS_DIR/$job.sh" ]; then   # user job
      if [ "$now" = 1 ]; then OPS_FORCE=1 exec bash "$(job_bin)" "$job"
      else exec systemctl --user start --no-block "dots-ops@$job.service"; fi
    else                                       # root job (R4)
      act=run; [ "$now" = 1 ] && act=run-now
      sudo_runner "$job" "$act"; rc=$?
      if [ "$rc" -ne 0 ]; then
        echo "dots-ops: $job $act failed (rc=$rc); sudo refused or runner error" >&2
        ops_state "$job" warn "run failed (rc=$rc)"; exit "$rc"
      fi
    fi ;;
  answer)
    [ $# -eq 3 ] || usage
    case $3 in approve|alt|skip|snooze) ;; *) usage ;; esac
    valid_job "$2"; ops_answer "$2" "$3" ;;
  idle-start)
    if [ "${2:-}" = --fallback ]; then   # R15: only when on AC and nobody is using the machine
      if ops_on_ac && { pgrep -x hyprlock >/dev/null 2>&1 || ! loginctl list-sessions --no-legend 2>/dev/null | grep -q .; }; then
        systemd-run --user --on-active=2h "$(readlink -f "$0")" idle-end >/dev/null 2>&1 || ops_log system warn "could not schedule idle-end"
      else
        ops_log system info "fallback skipped: not idle/AC"; exit 0
      fi
    fi
    mkdir -p "$(dirname "$OPS_IDLE_FLAG")"; touch "$OPS_IDLE_FLAG"
    systemctl --user restart --no-block dots-ops-idle.target || ops_log system warn "idle target failed to start"   # R14
    sudo_runner system idle-run || true ;;
  idle-end)
    rm -f "$OPS_IDLE_FLAG"
    systemctl --user stop --no-block dots-ops-idle.target || true
    sudo_runner system idle-end || true ;;   # R3
  relay) relay ;;
  waybar) ops_waybar_json ;;
  status)
    self=$(readlink -f "$0")
    command -v fzf >/dev/null || { echo "dots-ops: fzf not found" >&2; exit 1; }
    reload="reload($self _lines)"
    ops_status_lines | fzf --delimiter ' ⟂ ' --no-sort --reverse \
      --header 'enter: log · ctrl-a: approve · ctrl-s: snooze · ctrl-k: skip · ctrl-r: run now' \
      --bind "enter:execute($self _log {1} | ${PAGER:-less -R})" \
      --bind "ctrl-a:execute-silent($self answer {1} approve)+$reload" \
      --bind "ctrl-s:execute-silent($self answer {1} snooze)+$reload" \
      --bind "ctrl-k:execute-silent($self answer {1} skip)+$reload" \
      --bind "ctrl-r:execute-silent($self run {1} --now)+$reload" || true ;;
  _lines) ops_status_lines ;;   # internal: fzf reload source
  _log) valid_job "${2:-}"   # internal: last 50 log lines of one job
    tail -n 5000 "$OPS_STATE/log.jsonl" 2>/dev/null | jq -r --arg j "$2" 'select(.job==$j) | "\(.t) \(.level) \(.msg)"' | tail -n 50 ;;
  *) usage ;;
esac
