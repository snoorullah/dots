#!/usr/bin/env bash
# Run one dots-ops job: lock, enabled check, idle/AC gate for heavy jobs, then job_main.
set -uo pipefail
if [ "$(id -u)" = 0 ]; then LIB=/usr/local/lib/dots-ops/lib.sh   # R2: root never loads user-writable code
else LIB="${OPS_LIB:-$HOME/.local/lib/dots-ops/lib.sh}"; [ -f "$LIB" ] || LIB=/usr/local/lib/dots-ops/lib.sh; fi
source "$LIB"
: "${OPS_JOBS_DIR:=$( [ "$OPS_IS_ROOT" = 1 ] && echo /usr/local/lib/dots-ops/jobs || echo "$HOME/.local/lib/dots-ops/jobs")}"
: "${OPS_CONFIG:=$( [ "$OPS_IS_ROOT" = 1 ] && echo /etc/dots-ops/config.toml || echo "${XDG_CONFIG_HOME:-$HOME/.config}/dots-ops/config.toml")}"
ops_cfg() { local v; v=$(yq -p toml -oy ".$1" "$OPS_CONFIG" 2>/dev/null); if [ -n "$v" ] && [ "$v" != null ]; then echo "$v"; else echo "$2"; fi; }
[ "${1:-}" = --lib-only ] && return 0 2>/dev/null
job=${1:?usage: dots-ops-job <job>}
[[ $job =~ ^[a-z0-9-]+$ ]] || { echo "bad job name" >&2; exit 2; }
[ "$(ops_cfg "jobs.$job.enabled" true)" = true ] || { ops_log "$job" info "disabled in config"; exit 0; }
[ -f "$OPS_JOBS_DIR/$job.sh" ] || { ops_log "$job" fail "no such job"; exit 2; }
OPS_HEAVY=0; source "$OPS_JOBS_DIR/$job.sh"
ops_lock "$job"
if [ "$OPS_HEAVY" = 1 ] && [ "${OPS_FORCE:-0}" != 1 ] && ! ops_idle_ok; then
  ops_log "$job" info "skipped: not idle/AC"; exit 0
fi
[ "$OPS_IS_ROOT" = 1 ] || ops_flush_queue
job_main
