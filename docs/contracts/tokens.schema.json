{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dots-theme/tokens.schema.json",
  "title": "dots-theme tokens",
  "description": "~/.local/state/dots-theme/tokens.json. Written only by dots-theme, in preset or wallpaper mode, with an identical key set.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "source", "mode", "wallpaper", "color", "alpha", "radius", "space", "font", "motion", "bar"],
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "px": {
      "type": "integer",
      "minimum": 0
    },
    "unit": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "properties": {
    "v": { "const": 1 },
    "source": { "enum": ["preset", "wallpaper"] },
    "mode": { "const": "dark" },
    "wallpaper": { "type": ["string", "null"] },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bg", "surface", "surfaceDim", "surfaceContainer", "surfaceContainerHigh", "outline", "outlineVariant", "fg", "fgDim", "fgFaint", "accent", "accentFg", "waiting", "failed", "unknown"],
      "properties": {
        "bg": { "$ref": "#/$defs/hex" },
        "surface": { "$ref": "#/$defs/hex" },
        "surfaceDim": { "$ref": "#/$defs/hex" },
        "surfaceContainer": { "$ref": "#/$defs/hex" },
        "surfaceContainerHigh": { "$ref": "#/$defs/hex" },
        "outline": { "$ref": "#/$defs/hex" },
        "outlineVariant": { "$ref": "#/$defs/hex" },
        "fg": { "$ref": "#/$defs/hex" },
        "fgDim": { "$ref": "#/$defs/hex" },
        "fgFaint": { "$ref": "#/$defs/hex" },
        "accent": { "$ref": "#/$defs/hex" },
        "accentFg": { "$ref": "#/$defs/hex" },
        "waiting": { "$ref": "#/$defs/hex" },
        "failed": { "$ref": "#/$defs/hex" },
        "unknown": { "$ref": "#/$defs/hex" }
      }
    },
    "alpha": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slab", "panel", "wash", "hover", "divider", "rest", "on", "pressed"],
      "properties": {
        "slab": { "$ref": "#/$defs/unit" },
        "panel": { "$ref": "#/$defs/unit" },
        "wash": { "$ref": "#/$defs/unit" },
        "hover": { "$ref": "#/$defs/unit" },
        "divider": { "$ref": "#/$defs/unit" },
        "rest": { "$ref": "#/$defs/unit" },
        "on": { "$ref": "#/$defs/unit" },
        "pressed": { "$ref": "#/$defs/unit" }
      }
    },
    "radius": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chip", "row", "panel", "card", "pill"],
      "properties": {
        "chip": { "$ref": "#/$defs/px" },
        "row": { "$ref": "#/$defs/px" },
        "panel": { "$ref": "#/$defs/px" },
        "card": { "$ref": "#/$defs/px" },
        "pill": { "$ref": "#/$defs/px" }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xs", "s", "m", "l", "xl", "xxl", "xxxl", "xxxxl"],
      "properties": {
        "xs": { "$ref": "#/$defs/px" },
        "s": { "$ref": "#/$defs/px" },
        "m": { "$ref": "#/$defs/px" },
        "l": { "$ref": "#/$defs/px" },
        "xl": { "$ref": "#/$defs/px" },
        "xxl": { "$ref": "#/$defs/px" },
        "xxxl": { "$ref": "#/$defs/px" },
        "xxxxl": { "$ref": "#/$defs/px" }
      }
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sans", "mono", "icon", "size", "line", "weight", "track"],
      "properties": {
        "sans": {
          "type": "string",
          "minLength": 1
        },
        "mono": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "object",
          "additionalProperties": false,
          "required": ["caption", "bodyS", "body", "title", "headline", "page", "display"],
          "properties": {
            "caption": { "$ref": "#/$defs/px" },
            "bodyS": { "$ref": "#/$defs/px" },
            "body": { "$ref": "#/$defs/px" },
            "title": { "$ref": "#/$defs/px" },
            "headline": { "$ref": "#/$defs/px" },
            "page": { "$ref": "#/$defs/px" },
            "display": { "$ref": "#/$defs/px" }
          }
        },
        "line": {
          "type": "object",
          "additionalProperties": false,
          "required": ["caption", "bodyS", "body", "title", "headline", "page", "display"],
          "properties": {
            "caption": { "$ref": "#/$defs/px" },
            "bodyS": { "$ref": "#/$defs/px" },
            "body": { "$ref": "#/$defs/px" },
            "title": { "$ref": "#/$defs/px" },
            "headline": { "$ref": "#/$defs/px" },
            "page": { "$ref": "#/$defs/px" },
            "display": { "$ref": "#/$defs/px" }
          }
        },
        "weight": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "body", "title", "page", "display"],
          "properties": {
            "label": {
              "type": "integer",
              "minimum": 100,
              "maximum": 900
            },
            "body": {
              "type": "integer",
              "minimum": 100,
              "maximum": 900
            },
            "title": {
              "type": "integer",
              "minimum": 100,
              "maximum": 900
            },
            "page": {
              "type": "integer",
              "minimum": 100,
              "maximum": 900
            },
            "display": {
              "type": "integer",
              "minimum": 100,
              "maximum": 900
            }
          }
        },
        "track": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label"],
          "properties": {
            "label": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fast", "base", "slow", "fade", "easeIn", "easeOut"],
      "properties": {
        "fast": { "$ref": "#/$defs/px" },
        "base": { "$ref": "#/$defs/px" },
        "slow": { "type": "integer", "minimum": 0, "maximum": 180 },
        "fade": { "$ref": "#/$defs/px" },
        "easeIn": { "type": "string" },
        "easeOut": { "type": "string" }
      }
    },
    "bar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["height", "gutter", "chipGapPx"],
      "properties": {
        "height": { "const": 30 },
        "gutter": { "$ref": "#/$defs/px" },
        "chipGapPx": { "$ref": "#/$defs/px" }
      }
    }
  }
}
