#!/bin/bash
# Root entry point for approved/scheduled root work: the ONLY privilege path of dots-ops.
# Called as `sudo -n dots-ops-run <job> <action>` by group dots-ops (sudoers rule), or by root.
#   <job> run              start the system unit dots-ops@<job>.service (non-blocking)
#   <job> run-now          run the root job now, synchronously, bypassing the idle/AC gate (R4)
#   <job> <action>         source the approved action <prefix>/actions/<job>/<action>.sh
#   system idle-run|idle-end   set/clear the root idle flag and restart/stop dots-ops-system-idle.target (R3/R14)
# Only files under the root-owned prefix are ever sourced or executed. The absolute shebang matters:
# sudo may keep the caller's PATH, so `#!/usr/bin/env bash` would let the caller choose root's bash.
set -euo pipefail
umask 022
if [ "${OPS_TEST:-0}" = 1 ]; then   # tests only: never honoured for root
  [ "$(id -u)" != 0 ] || { echo "dots-ops-run: OPS_TEST refused as root" >&2; exit 2; }
  P=${OPS_ROOT_PREFIX:?}; JOB_BIN=$P/dots-ops-job; RUN_DIR=$P/run; SYSTEMCTL=(echo systemctl)
else
  [ "$(id -u)" = 0 ] || { echo "dots-ops-run: must run as root (sudo -n dots-ops-run ...)" >&2; exit 1; }
  # sudo resets most of the environment already; drop anything that could still steer the lib or a job
  for v in $(compgen -e); do case $v in OPS_*|DOTS_OPS_*|BASH_ENV|ENV|CDPATH|GLOBIGNORE) unset "$v" ;; esac; done
  export PATH=/run/wrappers/bin:/run/current-system/sw/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  export HOME=/root IFS=$' \t\n'
  P=/usr/local/lib/dots-ops; JOB_BIN=/usr/local/bin/dots-ops-job; RUN_DIR=/run/dots-ops; SYSTEMCTL=(systemctl)
fi

die() { echo "dots-ops-run: $1" >&2; exit 2; }
# root_owned <path>...: owned by root and not group/world writable (production only; catches a bad install)
root_owned() {
  [ "${OPS_TEST:-0}" = 1 ] && return 0
  local f; for f in "$@"; do
    [ -e "$f" ] && [ "$(stat -Lc '%u' "$f")" = 0 ] && [ $(( 0$(stat -Lc '%a' "$f") & 022 )) = 0 ] \
      || die "refusing $f: not root-owned or writable by others"
  done
}

[ $# -eq 2 ] || die "usage: dots-ops-run <job> <action>"
job=$1; act=$2
[[ $job =~ ^[a-z0-9][a-z0-9-]*$ && $act =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid job/action name"

if [ "$job" = system ]; then
  case $act in
    idle-run) mkdir -p -m 755 "$RUN_DIR"; touch "$RUN_DIR/idle"
              exec "${SYSTEMCTL[@]}" restart --no-block dots-ops-system-idle.target ;;   # restart re-pulls Wants= (R14)
    idle-end) rm -f "$RUN_DIR/idle"
              exec "${SYSTEMCTL[@]}" stop --no-block dots-ops-system-idle.target ;;
    *) die "unknown system action" ;;
  esac
fi

case $act in
  run|run-now)
    [ -f "$P/jobs/$job.sh" ] || die "unknown job"
    root_owned "$P/.." "$P" "$P/jobs" "$P/jobs/$job.sh"
    if [ "$act" = run ]; then exec "${SYSTEMCTL[@]}" start --no-block "dots-ops@$job.service"; fi
    root_owned "${JOB_BIN%/*}" "$JOB_BIN"
    OPS_FORCE=1 OPS_IS_ROOT=1 exec "$JOB_BIN" "$job" ;;
esac

f="$P/actions/$job/$act.sh"
[ -f "$f" ] || die "unknown action"
root_owned "$P/.." "$P" "$P/lib.sh" "$P/actions" "$P/actions/$job" "$f"
export OPS_IS_ROOT=1
source "$P/lib.sh"
ops_log "$job" action "$act (approved)"
source "$f"
