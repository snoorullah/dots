#!/usr/bin/env bash
# Bridge taskwarrior start/stop → timewarrior intervals, tagged by project.
# (taskwarrior runs hooks from data.location/hooks = ~/.task/hooks)
#
# Phase 5 (dotfiles/NixOS port): the get() helper below shells out to `python3
# -c` for JSON parsing, so python3 must be on PATH — guaranteed here by
# home.packages -> pythonEnv (python3.withPackages) in modules/timetrack.nix.
# `timew` is called bare too — taskwarrior3 + timewarrior are both installed
# via home.packages, so both resolve on the normal user PATH.
read -r old; read -r new
get(){ printf '%s' "$1" | python3 -c "import json,sys;d=json.load(sys.stdin);print(d.get('$2',''))"; }
o_start=$(get "$old" start); n_start=$(get "$new" start)
proj=$(get "$new" project); desc=$(get "$new" description)

# task START → timew start. Build tags WITHOUT empty values (an empty tag makes
# timewarrior throw "Internal error. Failed encode / decode check.").
if [ -z "$o_start" ] && [ -n "$n_start" ]; then
    tags=()
    [ -n "$proj" ] && tags+=("$proj")
    [ -n "$desc" ] && tags+=("$desc")
    timew start "${tags[@]}" :quiet 2>/dev/null || true
fi
# task STOP → timew stop.
if [ -n "$o_start" ] && [ -z "$n_start" ]; then
    timew stop :quiet 2>/dev/null || true
fi

# (Phase 5 dotfiles port: the live hook also backgrounded a refresh call to
# adhd-tasks-export.sh here, to update a quickshell drawer's task snapshot.
# That script is caelestia/quickshell-bound and is deliberately NOT installed
# on the laptop (no quickshell) — the call is dropped rather than left
# dangling. See modules/timetrack.nix for the full KEEP/DROP list.)

printf '%s\n' "$new"
