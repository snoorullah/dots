# ~/.zshenv  (PROPOSED, plain file; later: programs.zsh.envExtra / home.sessionVariables + home.sessionPath)
#
# Read by EVERY zsh: interactive, scripts, `zsh -c`, ssh commands, tmux panes.
# Rules for this file: environment only. No output. No `return 1` / `exit`.
# No commands that spawn processes. Never set ZDOTDIR here (that indirection is
# what broke the old HyDE ~/.zshenv: it sourced a $ZDOTDIR/.zshenv that was gone).

# --- XDG base dirs (defaults only; real values win) -------------------------
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

# --- Editor (dots: programs.neovim.defaultEditor = true) --------------------
export EDITOR=nvim
export VISUAL=nvim

# --- Per-tool homes that earlier PATH entries pointed at ---------------------
export PNPM_HOME="$XDG_DATA_HOME/pnpm"
export BUN_INSTALL="$HOME/.cache/.bun"

# --- ssh-agent: systemd user socket (ssh-agent.socket is enabled) -----------
# Do not override a forwarded agent when logged in over ssh.
[[ -n $SSH_CONNECTION ]] || export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$UID}/ssh-agent.socket"
# Old setup also exported these for the tmux-config askpass popup. Enable only
# after ~/.config/tmux/scripts/ssh-askpass.sh is restored:
# [[ -x $XDG_CONFIG_HOME/tmux/scripts/ssh-askpass.sh ]] && {
#   export SSH_ASKPASS="$XDG_CONFIG_HOME/tmux/scripts/ssh-askpass.sh"
#   export SSH_ASKPASS_REQUIRE=prefer
# }

# --- PATH: no hard export; unique; only dirs that exist ----------------------
# (N-/) = drop silently if the directory is missing. First entry wins.
typeset -U path PATH
path=(
  $HOME/.local/bin(N-/)
  $HOME/.grok/bin(N-/)
  $HOME/.npm-global/bin(N-/)
  $HOME/go/bin(N-/)
  $HOME/.cargo/bin(N-/)
  $BUN_INSTALL/bin(N-/)
  $PNPM_HOME(N-/)
  $path
  /usr/lib/rustup/bin(N-/)
)
# Dropped on purpose (dead or HyDE-only): ~/.local/opt/brew, zinit/polaris,
# ~/.local/lib/hyde, empty "::" entries, TERMINFO/TERMINFO_DIRS override,
# HYPRLAND_CONFIG, LESSHISTFILE=/tmp, PARALLEL_HOME, SCREENRC, WGETRC.
